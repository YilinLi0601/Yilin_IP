Mplus VERSION 9
MUTHEN & MUTHEN
01/26/2026   9:01 PM

INPUT INSTRUCTIONS

  TITLE:
  Aim3_1_2: DSEM with lagged affect, passive SI, low/high pleasant events;

  DATA:
  FILE IS EMA_DSEM3_pp.dat;

  VARIABLE:
  NAMES = ID affect psi plo phi plopSI phipSI time psi_b plo_b phi_b plopSI_b phipSI_b;
  USEVARIABLES = affect psi plo phi plopSI phipSI psi_b plo_b phi_b plopSI_b phipSI_b;
  CLUSTER = ID;
  MISSING = ALL(-9999);
  LAGGED = affect(1) psi(1);
  TINTERVAL = time (2 tbin);
  WITHIN = psi, plo, phi, plopSI, phipSI;
  BETWEEN = psi_b, plo_b, phi_b, plopSI_b, phipSI_b;

  ANALYSIS:
  TYPE = TWOLEVEL;
  ESTIMATOR = BAYES;
  CHAINS = 4;
  THIN = 50;
  BITERATIONS = (1000);

  PLOT:
  TYPE = PLOT3;

  MODEL:
  %WITHIN%
  psi;
  plo;
  phi;
  plopSI;
  phipSI;

  affect ON
  affect&1 (phi_aff)
  psi&1 (b_psilag)
  plo (b_plo)
  phi (b_phi)
  plopSI (b_plopSI)
  phipSI (b_phipSI);

  psi ON psi&1;

  %BETWEEN%
  affect;
  affect ON
  psi_b
  plo_b
  phi_b
  plopSI_b
  phipSI_b;

  OUTPUT:
  TECH1 TECH8;
  CINTERVAL;
  STANDARDIZED;



