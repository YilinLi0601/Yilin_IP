Mplus VERSION 9
MUTHEN & MUTHEN
01/27/2026   1:28 PM

INPUT INSTRUCTIONS

  TITLE:
  Aim3_2_2: DSEM with lagged affect, SMI, low/high pleasant events;

  DATA:
  FILE IS EMA_DSEM3_smip.dat;

  VARIABLE:
  NAMES = ID affect smi plo phi plosmi phismi time smi_b plo_b phi_b plosmi_b phismi_b;
  USEVARIABLES = affect smi plo phi plosmi phismi smi_b plo_b phi_b plosmi_b phismi_b;
  CLUSTER = ID;
  MISSING = ALL(-9999);
  LAGGED = affect(1) smi(1);
  TINTERVAL = time (2 tbin);
  WITHIN = smi, plo, phi, plosmi, phismi;
  BETWEEN = smi_b, plo_b, phi_b, plosmi_b, phismi_b;

  ANALYSIS:
  TYPE = TWOLEVEL;
  ESTIMATOR = BAYES;
  CHAINS = 4;
  THIN = 50;
  BITERATIONS = (1000);

  PLOT:
  TYPE = PLOT3;

  MODEL:
  %WITHIN%
  smi;
  plo;
  phi;
  plosmi;
  phismi;

  affect ON
  affect&1 (phi_aff)
  smi&1 (b_smilag)
  plo (b_plo)
  phi (b_phi)
  plosmi (b_plasmi)
  phismi (b_phismi);

  smi ON smi&1;

  %BETWEEN%
  affect;
  affect ON
  smi_b
  plo_b
  phi_b
  plosmi_b
  phismi_b;

  OUTPUT:
  TECH1 TECH8;
  CINTERVAL;
  STANDARDIZED;



