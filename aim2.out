INPUT INSTRUCTIONS

  TITLE:
  Aim2: DSEM with lagged affect, SI, low/high pleasant events;

  DATA:
  FILE IS EMA_DSEM2.dat;

  VARIABLE:
  NAMES = ID, affect, si, plo, phi, ploSI, phiSI, time, si_b, plo_b, phi_b, ploSI_b, phiSI_b
  USEVARIABLES = affect, si, plo, phi, ploSI, phiSI, si_b, plo_b, phi_b, ploSI_b, phiSI_b;
  CLUSTER = ID;
  MISSING = ALL(-9999);
  LAGGED = affect(1) SI(1);
  TINTERVAL = time (2 tbin);
  WITHIN = si, plo, phi, ploSI, phiSI;
  BETWEEN = si_b, plo_b, phi_b, ploSI_b, phiSI_b;

  ANALYSIS:
  TYPE = TWOLEVEL;
  ESTIMATOR = BAYES;
  CHAINS = 4;
  THIN = 50;
  BITERATIONS = (4000);
  PROCESSORS = 8;

  PLOT:
  TYPE = PLOT3;

  MODEL:
  %WITHIN%
  si;
  plo;
  phi;
  ploSI;
  phiSI;

  affect ON
  affect&1 (phi_aff)
  si&1 (b_silag)
  plo (b_plo)
  phi (b_phi)
  ploSI (b_ploSI)
  phiSI (b_phiSI);

  si ON si&1;

  %BETWEEN%
  affect si_b plo_b phi_b ploSI_b phiSI_b;
  affect ON
  si_b
  plo_b
  phi_b
  ploSI_b
  phiSI_b;

  OUTPUT:
  TECH1 TECH8;
  CINTERVAL;
  STANDARDIZED;



