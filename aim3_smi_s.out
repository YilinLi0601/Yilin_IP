Mplus VERSION 9
MUTHEN & MUTHEN
01/27/2026  11:52 AM

INPUT INSTRUCTIONS

  TITLE:
  Aim1: DSEM with lagged affect, SMI, low/high stress;

  DATA:
  FILE IS EMA_DSEM3_smis.dat;

  VARIABLE:
  NAMES = ID affect smi slo shi sloSI shiSI time smi_b slo_b shi_b slosmi_b shismi_b;
  USEVARIABLES = affect smi slo shi sloSI shiSI smi_b slo_b shi_b slosmi_b shismi_b;
  CLUSTER = ID;
  MISSING = ALL(-9999);
  LAGGED = affect(1) smi(1);
  TINTERVAL = time (2 tbin);
  WITHIN = smi slo shi sloSI shiSI;
  BETWEEN = smi_b, slo_b, shi_b, slosmi_b, shismi_b;

  ANALYSIS:
  TYPE = TWOLEVEL;
  ESTIMATOR = BAYES;
  CHAINS = 4;
  THIN = 50;
  BITERATIONS = (1000);

  PLOT:
  TYPE = PLOT3;

  MODEL:
  %WITHIN%
  smi;
  slo;
  shi;
  sloSI;
  shiSI;

  affect ON
  affect&1 (phi_aff)
  smi&1 (b_smilag)
  slo (b_slo)
  shi (b_shi)
  sloSI (b_sloSI)
  shiSI (b_shiSI);

  smi ON smi&1;

  %BETWEEN%
  affect;
  affect ON
  smi_b
  slo_b
  shi_b
  slosmi_b
  shismi_b;

  OUTPUT:
  TECH1 TECH8;
  CINTERVAL;
  STANDARDIZED;



