  MISSING = ALL(-9999);

  WITHIN =
  AFFECT_T_1
  SI_T_1
  STRESS_LOW
  STRESS_HIGH
  LS_SI_INT
  HS_SI_INT;

  BETWEEN = ;

  ANALYSIS:
