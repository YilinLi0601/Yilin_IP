  affect_T_1
  SI_T_1
  stress_low
  stress_high
  LS_SI_int
  HS_SI_int;

  USEVARIABLES =
  ID
  affect_post_stress
  affect_T_1
  SI_T_1
  stress_low
  stress_high
  LS_SI_int
