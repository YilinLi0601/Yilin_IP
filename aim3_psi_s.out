Mplus VERSION 9
MUTHEN & MUTHEN
01/26/2026   8:12 PM

INPUT INSTRUCTIONS

  TITLE:
  Aim3-1-1: post-hoc DSEM with lagged affect, passive SI and stressful events;

  DATA:
  FILE IS EMA_DSEM3_ps.dat;

  VARIABLE:
  NAMES = ID affect psi slo shi slopSI shipSI time psi_b slo_b shi_b slopSI_b shipSI_b;
  USEVARIABLES = affect psi slo shi slopSI shipSI psi_b slo_b shi_b slopSI_b shipSI_b;
  CLUSTER = ID;
  MISSING = ALL(-9999);
  LAGGED = affect(1) psi(1);
  TINTERVAL = time (2 tbin);
  WITHIN = psi, slo, shi, slopSI, shipSI;
  BETWEEN = psi_b, slo_b, shi_b, slopSI_b, shipSI_b;

  ANALYSIS:
  TYPE = TWOLEVEL;
  ESTIMATOR = BAYES;
  CHAINS = 4;
  THIN = 50;
  BITERATIONS = (1000);

  PLOT:
  TYPE = PLOT3;

  MODEL:
  %WITHIN%
  psi;
  slo;
  shi;
  slopSI;
  shipSI;

  affect ON
  affect&1 (phi_aff)
  psi&1 (b_psila)
  shi (b_shi)
  slo (b_slo)
  slopSI (b_slopSI)
  shipSI (b_shipSI);

  psi ON psi&1;

  %BETWEEN%
  affect;
  affect ON
  psi_b
  slo_b
  shi_b
  slopSI_b
  shipSI_b;

  OUTPUT:
  TECH1 TECH8;
  CINTERVAL;
  STANDARDIZED;



