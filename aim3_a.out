INPUT INSTRUCTIONS

  TITLE:
  Aim3-2: DSEM with lagged affect, active SI and events;

  DATA:
  FILE IS EMA_DSEM3_a.dat;

  VARIABLE:
  NAMES = ID asi_b pos_b str_b posSI_b strSI_b affect asi time pos str pasi sasi;
  USEVARIABLES = affect asi pos str pasi sasi asi_b pos_b str_b posSI_b strSI_b;
  CLUSTER = ID;
  MISSING = ALL(-9999);
  LAGGED = affect(1) asi(1);
  TINTERVAL = time (2 tbin);
  WITHIN = asi, pos, str, pasi, sasi;
  BETWEEN = asi_b, pos_b, str_b, posSI_b, strSI_b;

  ANALYSIS:
  TYPE = TWOLEVEL;
  ESTIMATOR = BAYES;
  CHAINS = 4;
  THIN = 50;
  BITERATIONS = (1000);
  PROCESSORS = 8;

  PLOT:
  TYPE = PLOT3;

  MODEL:
  %WITHIN%
  asi;
  pos;
  str;
  pasi;
  sasi;

  affect ON
  affect&1 (phi_aff)
  asi&1 (b_asila)
  pos (b_pos)
  str (b_str)
  pasi (b_pasi)
  sasi (b_sasi);

  asi ON asi&1;

  %BETWEEN%
  affect asi_b pos_b str_b posSI_b strSI_b;
  affect ON
  asi_b
  pos_b
  str_b
  posSI_b
  strSI_b;

  OUTPUT:
  TECH1 TECH8;
  CINTERVAL;
  STANDARDIZED;



