Mplus VERSION 9
MUTHEN & MUTHEN
01/26/2026   9:22 PM

INPUT INSTRUCTIONS

  TITLE:
  Aim1: DSEM with lagged affect, active SI, low/high stress;

  DATA:
  FILE IS EMA_DSEM3_as.dat;

  VARIABLE:
  NAMES = ID affect asi slo shi sloaSI shiaSI time asi_b slo_b shi_b sloaSI_b shiaSI_b;
  USEVARIABLES = affect asi slo shi sloaSI shiaSI asi_b slo_b shi_b sloaSI_b shiaSI_b;
  CLUSTER = ID;
  MISSING = ALL(-9999);
  LAGGED = affect(1) asi(1);
  TINTERVAL = time (2 tbin);
  WITHIN = asi slo shi sloaSI shiaSI;
  BETWEEN = asi_b, slo_b, shi_b, sloaSI_b, shiaSI_b;

  ANALYSIS:
  TYPE = TWOLEVEL;
  ESTIMATOR = BAYES;
  CHAINS = 4;
  THIN = 50;
  BITERATIONS = (1000);

  PLOT:
  TYPE = PLOT3;

  MODEL:
  %WITHIN%
  asi;
  slo;
  shi;
  sloaSI;
  shiaSI;

  affect ON
  affect&1 (phi_aff)
  asi&1 (b_asilag)
  slo (b_slo)
  shi (b_shi)
  sloaSI (b_sloaSI)
  shiaSI (b_shiaSI);

  asi ON asi&1;

  %BETWEEN%
  affect;
  affect ON
  asi_b
  slo_b
  shi_b
  sloaSI_b
  shiaSI_b;

  OUTPUT:
  TECH1 TECH8;
  CINTERVAL;
  STANDARDIZED;



