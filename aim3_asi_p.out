Mplus VERSION 9
MUTHEN & MUTHEN
01/26/2026   9:44 PM

INPUT INSTRUCTIONS

  TITLE:
  Aim3_2_2: DSEM with lagged affect, active SI, low/high pleasant events;

  DATA:
  FILE IS EMA_DSEM3_ap.dat;

  VARIABLE:
  NAMES = ID affect asi plo phi ploaSI phiaSI time asi_b plo_b phi_b ploaSI_b phiaSI_b;
  USEVARIABLES = affect asi plo phi ploaSI phiaSI asi_b plo_b phi_b ploaSI_b phiaSI_b;
  CLUSTER = ID;
  MISSING = ALL(-9999);
  LAGGED = affect(1) asi(1);
  TINTERVAL = time (2 tbin);
  WITHIN = asi, plo, phi, ploaSI, phiaSI;
  BETWEEN = asi_b, plo_b, phi_b, ploaSI_b, phiaSI_b;

  ANALYSIS:
  TYPE = TWOLEVEL;
  ESTIMATOR = BAYES;
  CHAINS = 4;
  THIN = 50;
  BITERATIONS = (1000);

  PLOT:
  TYPE = PLOT3;

  MODEL:
  %WITHIN%
  asi;
  plo;
  phi;
  ploaSI;
  phiaSI;

  affect ON
  affect&1 (phi_aff)
  asi&1 (b_asilag)
  plo (b_plo)
  phi (b_phi)
  ploaSI (b_plaoSI)
  phiaSI (b_phiaSI);

  asi ON asi&1;

  %BETWEEN%
  affect;
  affect ON
  asi_b
  plo_b
  phi_b
  ploaSI_b
  phiaSI_b;

  OUTPUT:
  TECH1 TECH8;
  CINTERVAL;
  STANDARDIZED;



