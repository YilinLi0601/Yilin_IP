MUTHEN & MUTHEN
02/18/2026  10:39 AM

INPUT INSTRUCTIONS

  TITLE:
  Aim3-1: DSEM with lagged affect, passive Si and events;

  DATA:
  FILE IS EMA_DSEM3_p.dat;

  VARIABLE:
  NAMES = ID psi_b pos_b str_b posSI_b strSI_b affect psi ppsi spsi time pos str;
  USEVARIABLES = affect psi pos str ppsi spsi psi_b pos_b str_b posSI_b strSI_b;
  CLUSTER = ID;
  MISSING = ALL(-9999);
  LAGGED = affect(1) psi(1);
  TINTERVAL = time (2 tbin);
  WITHIN = psi, pos, str, ppsi, spsi;
  BETWEEN = psi_b, pos_b, str_b, posSI_b, strSI_b;

  ANALYSIS:
  TYPE = TWOLEVEL;
  ESTIMATOR = BAYES;
  CHAINS = 4;
  THIN = 50;
  BITERATIONS = (1000);
  PROCESSORS = 8;

  PLOT:
  TYPE = PLOT3;

  MODEL:
  %WITHIN%
  psi;
  pos;
  str;
  ppsi;
  spsi;

  affect ON
  affect&1 (phi_aff)
  psi&1 (b_psila)
  pos (b_pos)
  str (b_str)
  ppsi (b_ppsi)
  spsi (b_spsi);

  psi ON psi&1;

  %BETWEEN%
  affect psi_b pos_b str_b posSI_b strSI_b;
  affect ON
  psi_b
  pos_b
  str_b
  posSI_b
  strSI_b;

  OUTPUT:
  TECH1 TECH8;
  CINTERVAL;
  STANDARDIZED;



